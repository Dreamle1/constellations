# Environment Variables Template
# Copy this file to .env and fill in your values

# API Configuration (Expo public env vars must use EXPO_PUBLIC_ prefix)
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_TIMEOUT=30000

# Authentication
EXPO_PUBLIC_AUTH_PROVIDER=firebase
EXPO_PUBLIC_AUTH_DOMAIN=

# OpenAI key for the backend (required for word generation API)
# Prefer packages/backend/.env; see packages/backend/.env.example
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
