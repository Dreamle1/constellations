{
  "name": "@constellations/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute constellations_words --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute constellations_words --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.24.0"
  }
}
